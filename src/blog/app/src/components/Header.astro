---
const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '/index.html';
const isResume = pathname === '/resume' || pathname.startsWith('/resume/');
const isProjects = pathname === '/projects' || pathname.startsWith('/projects/');
const isContact =
	pathname === '/contact' ||
	pathname.startsWith('/contact/') ||
	pathname === '/thankyou' ||
	pathname.startsWith('/thankyou/');
const isBlog = pathname === '/blog' || pathname.startsWith('/blog/');
---

<nav class="bg-gray-800" x-data="{ open: false }">
	<div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">
		<div class="relative flex h-16 items-center justify-between">
			<div class="absolute inset-y-0 left-0 flex items-center sm:hidden">
				<button
					type="button"
					class="inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white"
					aria-controls="mobile-menu"
					aria-expanded="false"
					@click="open = !open"
					x-bind:aria-expanded="open.toString()"
				>
					<span class="sr-only">Open main menu</span>
					<svg
						x-description="Icon when menu is closed."
						x-state:on="Menu open"
						x-state:off="Menu closed"
						class="h-6 w-6 block"
						:class="{ 'hidden': open, 'block': !(open) }"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
					</svg>
					<svg
						x-description="Icon when menu is open."
						x-state:on="Menu open"
						x-state:off="Menu closed"
						class="h-6 w-6 hidden"
						:class="{ 'block': open, 'hidden': !(open) }"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<div class="flex flex-1 items-center justify-center sm:items-stretch sm:justify-start">
				<div class="flex flex-shrink-0 items-center">
					<img class="h-8 w-auto" src="/img/devops-infinity-smallest.png" alt="DevOps Logo" />
				</div>
				<div class="flex flex-shrink-0 items-center hidden min-[300px]:flex md:hidden">
					<span class="text-gray-100 text-sm align-item-center">Ted McCormick</span>
				</div>
				<div class="hidden sm:ml-6 sm:block">
					<div class="flex space-x-4">
						<a
							href="/index.html"
							class={`rounded-md px-3 py-2 text-sm font-medium ${
								isHome ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
							}`}
							aria-current={isHome ? 'page' : undefined}
							>Home</a
						>
						<a
							href="/blog"
							class={`rounded-md px-3 py-2 text-sm font-medium ${
								isBlog ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
							}`}
							aria-current={isBlog ? 'page' : undefined}
							>Blog</a
						>
						<a
							href="/resume"
							class={`rounded-md px-3 py-2 text-sm font-medium ${
								isResume ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
							}`}
							aria-current={isResume ? 'page' : undefined}
							>Resume</a
						>
						<a
							href="/projects"
							class={`rounded-md px-3 py-2 text-sm font-medium ${
								isProjects ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
							}`}
							aria-current={isProjects ? 'page' : undefined}
							>Projects</a
						>
						<a
							href="/contact"
							class={`rounded-md px-3 py-2 text-sm font-medium ${
								isContact ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
							}`}
							aria-current={isContact ? 'page' : undefined}
							>Contact</a
						>
					</div>
				</div>
			</div>
			<div class="absolute inset-y-0 right-0 flex items-center pr-2 sm:static sm:inset-auto sm:ml-6 sm:pr-0">
				<span class="text-gray-100 text-sm hidden md:inline">Edward C. &quot;Ted&quot; McCormick</span>
				<div class="relative ml-3" x-data="{ open: false }">
					<div>
						<button
							type="button"
							class="flex rounded-full bg-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800"
							@click="open = ! open"
							aria-expanded="false"
							aria-haspopup="true"
						>
							<span class="sr-only">Open contact list</span>
							<img
								class="h-8 w-8 rounded-full"
								src="/img/tedProfilePicture.jpg"
								alt="A profile picture of Edward C. &quot;Ted&quot; McCormick"
							/>
						</button>
					</div>
					<div
						class="absolute right-0 z-10 mt-2 w-55 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
						role="menu"
						id="contactMenu"
						aria-orientation="vertical"
						aria-labelledby="user-menu-button"
						tabindex="-1"
						x-cloak
						x-show="open"
						x-transition:enter="transition ease-out duration-100"
						x-transition:enter-start="transform opacity-0 scale-95"
						x-transition:enter-end="transform opacity-100 scale-100"
						x-transition:leave="transition ease-in duration-75"
						x-transition:leave-start="transform opacity-100 scale-100"
						x-transition:leave-end="transform opacity-0 scale-95"
					>
						<p>
							<a
								href="https://www.linkedin.com/in/ted-mccormick/"
								class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-300 hover:text-black"
								role="menuitem"
								tabindex="-1"
								id="user-menu-item-0"
								target="_blank"
							>
								LinkedIn
								<img class="h-5 w-5 inline" src="/img/LI-In-Bug.png" alt="The LinkedIn Logo" />
							</a>
						</p>
						<a
							href="https://github.com/edwardmccormick"
							class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-300 hover:text-black"
							role="menuitem"
							tabindex="-1"
							id="user-menu-item-1"
							target="_blank"
						>
							Github <img class="h-5 w-5 inline" src="/img/github-mark.svg" alt="The GitHub Logo" />
						</a>

						<a
							href="tel:2108236753"
							class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-300 hover:text-black"
							role="menuitem"
							tabindex="-1"
							id="user-menu-item-2"
							target="_blank"
							>Cell: (210) 823-6753</a
						>
						<button
							class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-300 hover:text-black tooltip"
							role="menuitem"
							tabindex="-1"
							id="user-menu-item-3"
							onclick="copyEmail()"
							onmouseout="outFunc(this)"
						>
							<span class="tooltiptext" id="emailTooltip">Copy to clipboard</span>nickname.lastname@gmail.com
						</button>
						<button
							class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-300 hover:text-black tooltip"
							role="menuitem"
							tabindex="-1"
							id="user-menu-item-4"
							onclick="copyEmailSecure()"
							onmouseout="outFunc(this)"
						>
							<span class="tooltiptext" id="secureEmailTooltip">Copy to clipboard</span
							>nickname.lastname@protonmail.com
						</button>
					</div>
				</div>
			</div>
		</div>

		<div class="sm:hidden" id="mobile-menu" x-show="open" style="display: none;">
			<div class="space-y-1 px-2 pb-3 pt-2">
				<a
					href="/index.html"
					class={`block rounded-md px-3 py-2 text-base font-medium ${
						isHome ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
					}`}
					aria-current={isHome ? 'page' : undefined}
					>Home</a
				>
				<a
					href="/blog"
					class={`block rounded-md px-3 py-2 text-base font-medium ${
						isBlog ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
					}`}
					aria-current={isBlog ? 'page' : undefined}
					>Blog</a
				>
				<a
					href="/resume"
					class={`block rounded-md px-3 py-2 text-base font-medium ${
						isResume ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
					}`}
					aria-current={isResume ? 'page' : undefined}
					>Resume</a
				>
				<a
					href="/projects"
					class={`block rounded-md px-3 py-2 text-base font-medium ${
						isProjects ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
					}`}
					aria-current={isProjects ? 'page' : undefined}
					>Projects</a
				>
				<a
					href="/contact"
					class={`block rounded-md px-3 py-2 text-base font-medium ${
						isContact ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'
					}`}
					aria-current={isContact ? 'page' : undefined}
					>Contact</a
				>
			</div>
		</div>
	</div>
</nav>
