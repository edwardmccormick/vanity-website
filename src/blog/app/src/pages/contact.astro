---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Email Ted McCormick, DevOps Engineer and Software Developer"
			description="This is the 'contact me' page from the personal homepage and/or professional website for Edward C. 'Ted' McCormick, a software developer, DevOps Engineer, and Cloud Architect."
		/>
		<script src="/js/contact.js" is:inline></script>
	</head>
	<body class="min-h-screen">
		<Header />
		<main class="max-w-7xl xl:mx-auto">
			<div class="m-1 p-6 max-w-7xl">
				<div class="py-8 px-4 md:py-16 md:px-8 mb-8 bg-gray-200 rounded pr-0 pl-0 rounded-none p-0 bg-gray-900 GWR">
					<div class="container mx-auto sm:px-4 quote">
						<h1 class="text-4xl text text-white">
							"We should ask ourselves two questions:
							<em><strong>If not now, when? If not us, who?</strong></em>
						</h1>
						<h4 class="text-right text-white">George W. Romney,<br />September 13, 1963</h4>
					</div>
				</div>
				<div class="m-4 min-h-min">
					<h1>Contact Me:</h1>
					<form method="POST" action="https://api.mccormickhub.com/contact">
						<div class="flex flex-wrap m-0 p-0">
							<div id="alert" class="mb-4 w-full lg:w-1/4 pr-4 pl-4">
								<label for="email">Email address</label>
								<input
									type="email"
									class="block appearance-none w-full py-1 px-2 mb-1 text-base leading-normal bg-white text-gray-800 border border-gray-200 rounded"
									id="email"
									name="email"
									placeholder="name@example.com"
								/>
								<small id="emailHelp" class="block mt-1 text-gray-700"
									>You will receive an automated reply, and then a personal reply. I do not collect or keep
									email addresses.</small
								>
							</div>
							<br />

							<div class="mb-4 w-full md:w-1/2 pr-4 pl-4 lg:w-1/4">
								<label for="name">Your name?</label>
								<input
									type="text"
									class="block appearance-none w-full py-1 px-2 mb-1 text-base leading-normal bg-white text-gray-800 border border-gray-200 rounded"
									name="name"
									id="name"
									placeholder="Your name here."
								/>
							</div>
							<div class="mb-4 w-full md:w-1/2 pr-4 pl-4 lg:w-1/4">
								<label for="source">Reason for your contact</label>
								<select
									class="block appearance-none w-full py-1 px-2 mb-1 text-base leading-normal bg-white text-gray-800 border border-gray-200 rounded"
									id="source"
									name="source"
								>
									<option value="Resume or Application Follow Up">You submitted a resume or application</option>
									<option value="Found through LinkedIn">LinkedIn</option>
									<option value="Visited Website" selected>Visited Site and wanted to contact</option>
									<option value="Let's Collaborate">I would like to collaborate with you</option>
									<option value="Codeup Referral">Codeup Website</option>
									<option value="Other Social Media">Other Social Media</option>
									<option value="Other">Other</option>
								</select>
							</div>

							<br />

							<div class="mb-4 w-full md:w-1/2 pr-4 pl-4 lg:w-1/4">
								<label for="phone">Contact number?</label>
								<input
									type="text"
									class="block appearance-none w-full py-1 px-2 mb-1 text-base leading-normal bg-white text-gray-800 border border-gray-200 rounded"
									name="phone"
									id="phone"
									placeholder="(555) 555-555"
									pattern="^[+]?[1]?[\s]?[(]?[0-9]{3}[)]?[-\s\.]?[0-9]{3}[-\s\.]?[0-9]{4,6}$"
								/>
							</div>
							<div class="mb-4 w-full">
								<label for="bodytext">Message</label>
								<textarea
									class="block appearance-none w-full py-1 px-2 mb-1 text-base leading-normal bg-white text-gray-800 border border-gray-200 rounded"
									id="bodytext"
									rows="5"
									placeholder="Body of message here."
									name="bodtext"
								></textarea>
							</div>

							<div class="w-full flex flex-row justify-end">
								<button
									type="submit"
									id="contactButton"
									class="w-full sm:w-auto align-middle text-center select-none border font-normal whitespace-no-wrap rounded no-underline bg-gray-600 text-white hover:bg-gray-700 p-4 leading-tight text-xl m-3 duration-500"
								>
									<span>Contact/Submit</span>
								</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
