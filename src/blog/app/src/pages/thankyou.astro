---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Thank You For Contacting Ted McCormick, DevOps Engineer and Software Developer"
			description="This is the thank-you page from the personal/professional website for Edward C. 'Ted' McCormick, a software developer, DevOps Engineer, and Cloud Architect."
		/>
	</head>
	<body class="min-h-screen">
		<Header />
		<main class="m-4">
			<div class="m-1 p-3">
				<div class="py-8 px-4 md:py-16 md:px-8 mb-8 bg-gray-200 rounded pr-0 pl-0 rounded-none p-0 bg-gray-90 branson">
					<div class="container mx-auto sm:px-4 quote">
						<p class="text-4xl text text-white">
							"Hiring the right people takes time, the right questions, and a healthy dose of curiosity. What do
							you think is the most important factor when building your team?
							<span class=""><strong>For us, it's personality."</strong></span>
						</p>
						<h4 class="text-right text-white">Richard Branson</h4>
					</div>
				</div>
				<h1>
					Thank you for getting in touch with me - I'll be back with you as soon as possible. In the meantime
					feel free to have a look around.
				</h1>
				<br />
				<h3>Social Media</h3>
				<ul class="container flex flex-wrap justify-between m-1 p-1 text-center gap-4">
					<li><a href="https://www.linkedin.com/in/ted-mccormick/">LinkedIn</a></li>
					<li><a href="https://github.com/edwardmccormick">Github</a></li>
					<li><a href="https://twitter.com/ted_codes">Twitter</a></li>
					<li>Phone: 210-823-6753</li>
					<li><a href="/">Vanity Site/Interactive Portfolio</a></li>
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
